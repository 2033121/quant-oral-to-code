from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys

import jqdatasdk as jq
import pandas as pd

WORKSPACE_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = WORKSPACE_ROOT.parents[1]
SCRIPT_ROOT = REPO_ROOT / "skills" / "quant-oral-to-code" / "scripts"
if str(SCRIPT_ROOT) not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT))

from normalize_to_duckdb import normalize_to_duckdb


PROVIDER_NAME = "$provider_name"
DEPENDENCY_NAME = "$dependency_name"
AUTH_METHOD = "$auth_method"
USER_ENV_NAME = "JQDATA_USERNAME"
PASSWORD_ENV_NAME = "JQDATA_PASSWORD"
DEFAULT_SYMBOL = "$symbol"
DEFAULT_START_DATE = "$start_date"
DEFAULT_END_DATE = "$end_date"
RAW_OUTPUT = WORKSPACE_ROOT / "data" / "raw" / "market_$provider_name.csv"
DUCKDB_OUTPUT = WORKSPACE_ROOT / "data" / "normalized" / "market.duckdb"


def fetch_history(
    symbol: str,
    start_date: str,
    end_date: str,
    username: str | None = None,
    password: str | None = None,
) -> pd.DataFrame:
    actual_username = username or os.getenv(USER_ENV_NAME)
    actual_password = password or os.getenv(PASSWORD_ENV_NAME)
    if not actual_username or not actual_password:
        raise RuntimeError(f"missing {USER_ENV_NAME} or {PASSWORD_ENV_NAME}")
    jq.auth(actual_username, actual_password)
    df = jq.get_price(
        symbol,
        start_date=start_date,
        end_date=end_date,
        frequency="daily",
        fields=["open", "high", "low", "close", "volume"],
    )
    df = df.reset_index().rename(columns={"index": "trade_date"})
    df["symbol"] = symbol
    return df[["symbol", "trade_date", "open", "high", "low", "close", "volume"]].copy()


def main(
    symbol: str,
    start_date: str,
    end_date: str,
    username: str | None = None,
    password: str | None = None,
) -> dict[str, object]:
    RAW_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    df = fetch_history(
        symbol=symbol,
        start_date=start_date,
        end_date=end_date,
        username=username,
        password=password,
    )
    df.to_csv(RAW_OUTPUT, index=False, encoding="utf-8-sig")
    return normalize_to_duckdb(RAW_OUTPUT, DUCKDB_OUTPUT, raw_input_format="csv", adjustment_mode="qfq")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Fetch A-share history with JQData SDK and normalize to DuckDB.")
    parser.add_argument("--symbol", default=DEFAULT_SYMBOL)
    parser.add_argument("--start-date", default=DEFAULT_START_DATE)
    parser.add_argument("--end-date", default=DEFAULT_END_DATE)
    parser.add_argument("--username", default=None)
    parser.add_argument("--password", default=None)
    args = parser.parse_args()
    result = main(
        symbol=args.symbol,
        start_date=args.start_date,
        end_date=args.end_date,
        username=args.username,
        password=args.password,
    )
    print(result)
