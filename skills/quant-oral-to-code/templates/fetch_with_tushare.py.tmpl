from __future__ import annotations

import argparse
import importlib.util
import json
import os
from pathlib import Path

import pandas as pd
import tushare as ts

WORKSPACE_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT_SENTINELS = (".git", "docs", "skills")
SKILL_SCRIPT_SENTINELS = ("normalize_to_duckdb.py", "context_data_helpers.py")


def _resolve_repo_root() -> Path:
    for candidate in (WORKSPACE_ROOT, *WORKSPACE_ROOT.parents):
        script_root = candidate / "skills" / "quant-oral-to-code" / "scripts"
        has_repo_sentinels = all((candidate / sentinel).exists() for sentinel in REPO_ROOT_SENTINELS)
        has_skill_sentinels = all((script_root / sentinel).exists() for sentinel in SKILL_SCRIPT_SENTINELS)
        if has_repo_sentinels and has_skill_sentinels:
            return candidate
    raise FileNotFoundError(f"Could not locate quant-oral-to-code skill root from {WORKSPACE_ROOT}")


REPO_ROOT = _resolve_repo_root()
SCRIPT_ROOT = REPO_ROOT / "skills" / "quant-oral-to-code" / "scripts"


def _load_module(module_filename: str, module_name: str):
    module_path = SCRIPT_ROOT / module_filename
    spec = importlib.util.spec_from_file_location(module_name, module_path)
    if spec is None or spec.loader is None:
        raise ImportError(f"Could not load {module_filename} from {module_path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


normalize_to_duckdb = _load_module(
    "normalize_to_duckdb.py",
    "quant_oral_to_code_normalize_to_duckdb",
).normalize_to_duckdb
persist_real_data_artifacts = _load_module(
    "context_data_helpers.py",
    "quant_oral_to_code_context_data_helpers",
).persist_real_data_artifacts


PROVIDER_NAME = "$provider_name"
DEPENDENCY_NAME = "$dependency_name"
AUTH_METHOD = "$auth_method"
TOKEN_ENV_NAME = "TUSHARE_TOKEN"
DEFAULT_SYMBOL = "$symbol"
DEFAULT_START_DATE = "$start_date"
DEFAULT_END_DATE = "$end_date"
DEFAULT_BENCHMARK = "000300.SH"
RAW_OUTPUT = WORKSPACE_ROOT / "data" / "raw" / "market_$provider_name.csv"
DUCKDB_OUTPUT = WORKSPACE_ROOT / "data" / "normalized" / "market.duckdb"
CONTEXT_REPORT_OUTPUT = WORKSPACE_ROOT / "data" / "context_fetch_report.json"
DATA_CONTRACT_OUTPUT = WORKSPACE_ROOT / "data_contract.json"
PROVIDER_CONTEXT_SUPPORT = json.loads("""$context_support_json""")


def _get_pro(token: str | None = None):
    actual_token = token or os.getenv(TOKEN_ENV_NAME)
    if not actual_token:
        raise RuntimeError(f"missing {TOKEN_ENV_NAME}")
    ts.set_token(actual_token)
    return ts.pro_api()


def _ensure_ts_code(symbol: str) -> str:
    return symbol if "." in symbol else f"{symbol}.SZ"


def fetch_history(symbol: str, start_date: str, end_date: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    ts_code = _ensure_ts_code(symbol)
    df = pro.daily(
        ts_code=ts_code,
        start_date=start_date.replace("-", ""),
        end_date=end_date.replace("-", ""),
    )
    if df.empty:
        raise RuntimeError(f"no daily bars returned for {ts_code}")
    df["symbol"] = ts_code
    df = df.rename(columns={"vol": "volume"})
    df["trade_date"] = pd.to_datetime(df["trade_date"]).dt.strftime("%Y-%m-%d")
    df = df.sort_values(["symbol", "trade_date"]).reset_index(drop=True)
    return df[["symbol", "trade_date", "open", "high", "low", "close", "volume"]].copy()


def fetch_security_master(symbol: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    ts_code = _ensure_ts_code(symbol)
    df = pro.stock_basic(ts_code=ts_code, fields="ts_code,symbol,name,area,industry,market,list_date,list_status")
    if df.empty:
        raise RuntimeError(f"no security master returned for {ts_code}")
    return df.rename(
        columns={
            "ts_code": "symbol",
            "name": "security_name",
            "industry": "industry_name",
            "market": "market_name",
            "list_date": "list_date",
            "list_status": "list_status",
        }
    )[
        ["symbol", "security_name", "area", "industry_name", "market_name", "list_date", "list_status"]
    ].copy()


def fetch_st_status(symbol: str, start_date: str, end_date: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    ts_code = _ensure_ts_code(symbol)
    df = pro.namechange(
        ts_code=ts_code,
        start_date=start_date.replace("-", ""),
        end_date=end_date.replace("-", ""),
        fields="ts_code,name,start_date,end_date,change_reason",
    )
    if df.empty:
        return pd.DataFrame(columns=["symbol", "effective_from", "effective_to", "is_st", "reason"])
    reason_text = df["change_reason"].fillna("") + df["name"].fillna("")
    df["is_st"] = reason_text.str.contains("ST", case=False, regex=False)
    return df.rename(
        columns={
            "ts_code": "symbol",
            "start_date": "effective_from",
            "end_date": "effective_to",
            "change_reason": "reason",
        }
    )[
        ["symbol", "effective_from", "effective_to", "is_st", "reason"]
    ].copy()


def fetch_suspension_status(symbol: str, start_date: str, end_date: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    ts_code = _ensure_ts_code(symbol)
    df = pro.suspend_d(
        ts_code=ts_code,
        start_date=start_date.replace("-", ""),
        end_date=end_date.replace("-", ""),
    )
    if df.empty:
        return pd.DataFrame(columns=["symbol", "trade_date", "is_suspended", "suspend_timing", "suspend_reason"])
    return df.rename(
        columns={
            "ts_code": "symbol",
            "trade_date": "trade_date",
            "suspend_timing": "suspend_timing",
            "suspend_reason": "suspend_reason",
        }
    ).assign(is_suspended=True)[
        ["symbol", "trade_date", "is_suspended", "suspend_timing", "suspend_reason"]
    ].copy()


def fetch_group_membership(symbol: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    ts_code = _ensure_ts_code(symbol)
    security_master = fetch_security_master(ts_code, token=token)
    industry_name = str(security_master.iloc[0]["industry_name"])
    return pd.DataFrame(
        [
            {
                "symbol": ts_code,
                "group_type": "industry",
                "group_code": industry_name,
                "group_name": industry_name,
                "effective_from": str(security_master.iloc[0]["list_date"]),
                "effective_to": None,
            }
        ]
    )


def fetch_benchmark_series(benchmark_code: str, start_date: str, end_date: str, token: str | None = None) -> pd.DataFrame:
    pro = _get_pro(token=token)
    df = pro.index_daily(
        ts_code=benchmark_code,
        start_date=start_date.replace("-", ""),
        end_date=end_date.replace("-", ""),
    )
    if df.empty:
        raise RuntimeError(f"no benchmark series returned for {benchmark_code}")
    df["trade_date"] = pd.to_datetime(df["trade_date"]).dt.strftime("%Y-%m-%d")
    return df.rename(
        columns={
            "ts_code": "benchmark_code",
            "vol": "volume",
        }
    )[
        ["benchmark_code", "trade_date", "open", "high", "low", "close", "volume"]
    ].copy()


def fetch_context_payload(
    symbol: str,
    start_date: str,
    end_date: str,
    benchmark_code: str,
    token: str | None = None,
) -> dict[str, object]:
    return {
        "security_master": fetch_security_master(symbol, token=token),
        "st_status": fetch_st_status(symbol, start_date=start_date, end_date=end_date, token=token),
        "suspension_status": fetch_suspension_status(symbol, start_date=start_date, end_date=end_date, token=token),
        "group_membership": fetch_group_membership(symbol, token=token),
        "benchmark_series": fetch_benchmark_series(
            benchmark_code=benchmark_code,
            start_date=start_date,
            end_date=end_date,
            token=token,
        ),
    }


def main(
    symbol: str,
    start_date: str,
    end_date: str,
    token: str | None = None,
    benchmark_code: str = DEFAULT_BENCHMARK,
) -> dict[str, object]:
    RAW_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    history = fetch_history(symbol=symbol, start_date=start_date, end_date=end_date, token=token)
    history.to_csv(RAW_OUTPUT, index=False, encoding="utf-8-sig")
    normalization = normalize_to_duckdb(RAW_OUTPUT, DUCKDB_OUTPUT, raw_input_format="csv", adjustment_mode="qfq")
    context_payload = fetch_context_payload(
        symbol=symbol,
        start_date=start_date,
        end_date=end_date,
        benchmark_code=benchmark_code,
        token=token,
    )
    artifacts = persist_real_data_artifacts(
        storage_target=DUCKDB_OUTPUT,
        raw_input_format="csv",
        provider_name=PROVIDER_NAME,
        adjustment_mode="qfq",
        context_payload=context_payload,
        provider_support=PROVIDER_CONTEXT_SUPPORT,
        selection_method="single_symbol_api",
        contract_output_path=DATA_CONTRACT_OUTPUT,
        context_report_output_path=CONTEXT_REPORT_OUTPUT,
        benchmark_code=benchmark_code,
        universe_name="single_symbol_a_share",
    )
    return {
        **normalization,
        "provider_name": PROVIDER_NAME,
        "raw_output": str(RAW_OUTPUT),
        "context_report_file": artifacts["context_report_file"],
        "data_contract_file": artifacts["data_contract_file"],
        "context_tables": artifacts["context_tables"],
        "sample_coverage": artifacts["sample_coverage"],
    }


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Fetch A-share history with TuShare and normalize to DuckDB.")
    parser.add_argument("--symbol", default=DEFAULT_SYMBOL)
    parser.add_argument("--start-date", default=DEFAULT_START_DATE)
    parser.add_argument("--end-date", default=DEFAULT_END_DATE)
    parser.add_argument("--token", default=None)
    parser.add_argument("--benchmark-code", default=DEFAULT_BENCHMARK)
    args = parser.parse_args()
    result = main(
        symbol=args.symbol,
        start_date=args.start_date,
        end_date=args.end_date,
        token=args.token,
        benchmark_code=args.benchmark_code,
    )
    print(result)
