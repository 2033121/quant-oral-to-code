      "dependency": "akshare",
      "notes": "零门槛优先默认项，适合 A 股日线历史行情。"
    },
    {
      "name": "efinance",
      "tier": "tier_a_no_auth",
      "auth": "none",
      "supports_history_bars": true,
      "supports_intraday": true,
      "decision_default": "generated_fetcher",
      "dependency": "efinance",
      "notes": "东财系零门槛备选，适合快速拉股票与 ETF 历史行情。"
    },
    {
      "name": "adata",
      "tier": "tier_a_no_auth",
      "auth": "none",
      "supports_history_bars": true,
      "supports_intraday": true,
      "decision_default": "generated_fetcher",
      "dependency": "adata",
      "notes": "多数据源聚合备选，适合做数据落地。"
    },
    {
      "name": "baostock",
      "tier": "tier_a_no_auth",
      "auth": "anonymous",
      "supports_history_bars": true,
      "supports_intraday": false,
