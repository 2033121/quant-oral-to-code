{
  "version": "2026-06-23",
  "default_policy": {
    "prefer_zero_setup_first": true,
    "normalized_storage": "data/normalized/market.duckdb",
    "cutoff_decision": "data_required_cutoff"
  },
  "providers": [
    {
      "name": "akshare",
      "tier": "tier_a_no_auth",
      "auth": "none",
      "supports_history_bars": true,
      "supports_intraday": false,
      "supports_context_tables": {
        "security_master": false,
        "st_status": false,
        "suspension_status": false,
        "group_membership": false,
        "benchmark_series": true
      },
      "decision_default": "generated_fetcher",
      "dependency": "akshare",
      "notes": "零门槛优先选项，适合 A 股日线历史行情。"
    },
    {
      "name": "efinance",
      "tier": "tier_a_no_auth",
      "auth": "none",
      "supports_history_bars": true,
      "supports_intraday": true,
      "supports_context_tables": {
        "security_master": false,
        "st_status": false,
        "suspension_status": false,
        "group_membership": false,
        "benchmark_series": true
      },
      "decision_default": "generated_fetcher",
      "dependency": "efinance",
      "notes": "东方财富公开接口，适合快速抓取个股与 ETF 历史行情。"
    },
    {
      "name": "adata",
      "tier": "tier_a_no_auth",
      "auth": "none",
      "supports_history_bars": true,
      "supports_intraday": true,
      "supports_context_tables": {
        "security_master": false,
        "st_status": false,
        "suspension_status": false,
        "group_membership": false,
        "benchmark_series": false
      },
      "decision_default": "generated_fetcher",
      "dependency": "adata",
      "notes": "多数据源聚合备选，适合先拿到行情后再补全上下文。"
    },
    {
      "name": "baostock",
      "tier": "tier_a_no_auth",
      "auth": "anonymous",
      "supports_history_bars": true,
      "supports_intraday": false,
      "supports_context_tables": {
        "security_master": true,
        "st_status": false,
        "suspension_status": true,
        "group_membership": false,
        "benchmark_series": true
      },
      "decision_default": "generated_fetcher",
      "dependency": "baostock",
      "notes": "匿名登录的公共历史数据源，可部分补上市状态与停牌信息。"
    },
    {
      "name": "tushare",
      "tier": "tier_b_auth_or_trial",
      "auth": "token",
      "supports_history_bars": true,
      "supports_intraday": false,
      "supports_context_tables": {
        "security_master": true,
        "st_status": true,
        "suspension_status": true,
        "group_membership": true,
        "benchmark_series": true
      },
      "decision_default": "generated_fetcher",
      "dependency": "tushare",
      "notes": "需要 token，适合完整 A 股研究级上下文抓取。"
    },
    {
      "name": "jqdatasdk",
      "tier": "tier_b_auth_or_trial",
      "auth": "username_password",
      "supports_history_bars": true,
      "supports_intraday": true,
      "supports_context_tables": {
        "security_master": true,
        "st_status": true,
        "suspension_status": true,
        "group_membership": true,
        "benchmark_series": true
      },
      "decision_default": "generated_fetcher",
      "dependency": "jqdatasdk",
      "notes": "需要聚宽账号认证，适合完整上下文与板块语义相关研究。"
    },
    {
      "name": "manual_csv",
      "tier": "tier_d_manual_csv",
      "auth": "manual_export",
      "supports_history_bars": true,
      "supports_intraday": true,
      "supports_context_tables": {
        "security_master": false,
        "st_status": false,
        "suspension_status": false,
        "group_membership": false,
        "benchmark_series": false
      },
      "decision_default": "data_required_cutoff",
      "dependency": "none",
      "notes": "只表示用户已有手工导出的行情文件，默认仍然缺上下文，不直接放行。"
    }
  ],
  "fallback_order": [
    "akshare",
    "efinance",
    "adata",
    "baostock",
    "tushare",
    "jqdatasdk",
    "manual_csv"
  ]
}
